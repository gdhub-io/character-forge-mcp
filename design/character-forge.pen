                    {
                      "type": "frame",
                      "id": "yPmm8",
                      "name": "Biography",
                      "width": "fill_container",
                      "layout": "vertical",
                      "gap": 14,
                      "padding": [
                        8,
                        0
                      ],
                      "children": [
                        {
                          "type": "text",
                          "id": "MdLzK",
                          "name": "Subhead",
                          "fill": "$ink",
                          "content": "BIOGRAPHY",
                          "fontFamily": "$font-mono",
                          "fontSize": 11,
                          "fontWeight": "600",
                          "letterSpacing": 1.2
                        },
                        {
                          "type": "text",
                          "id": "KCnZd",
                          "name": "Prose",
                          "fill": "$ink",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "Marta grew up in the Saltreach lighthouse as her father's apprentice rather than his daughter. She learned morse before she could read and heard storms before the barometer moved, but he laughed at her forecasts. The first man who ever paid for her gift was Doran Hale. At twenty-six she heard the Rising coming three days out and signed his receipt — four hundred credits to say nothing. On the second night her father, for the first time in his life, asked her if a storm was coming. She said no. On the third night she ran for the foghorn as the water rose and sounded it at point-blank range — too late for the town, and loud enough to burst her left eardrum.",
                          "lineHeight": 1.65,
                          "fontFamily": "$font-display",
                          "fontSize": 18,
                          "fontWeight": "normal"
                        }
                      ]
                    },
