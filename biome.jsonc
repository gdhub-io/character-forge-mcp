{
	"$schema": "https://biomejs.dev/schemas/2.6.6/schema.json",
	"vcs": {
		"enabled": false,
		"clientKind": "git",
		"useIgnoreFile": false
	},
	"files": {
		"ignoreUnknown": false,
		// Build output and the character library (images, video, sound) are generated: never scan, lint or format
		// them ("!!" also keeps the editor's scanner out of them).
		"includes": ["**", "!!**/dist", "!!characters", "!!site/public"]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"includes": [
			"src/**/*.ts",
			"test/**/*.mjs",
			"site/src/**/*.ts",
			"site/src/**/*.tsx",
			"site/scripts/**/*.mjs"
		]
	},
	"linter": {
		"enabled": true,
		"includes": [
			"src/**/*.ts",
			"test/**/*.mjs",
			"site/src/**/*.ts",
			"site/src/**/*.tsx",
			"site/scripts/**/*.mjs"
		],
		"rules": {
			"preset": "recommended",
			"suspicious": {
				"noDoubleEquals": "warn"
			},
			"correctness": {
				"useExhaustiveDependencies": "warn"
			},
			"a11y": {
				"useKeyWithClickEvents": "off",
				"useSemanticElements": "off"
			}
		}
	},
	"css": {
		// The site's stylesheet uses Tailwind v4 directives (@theme, @apply).
		"parser": { "tailwindDirectives": true }
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	}
}
