{
  "name": "@gdhub/character-forge-mcp",
  "version": "0.3.1",
  "mcpName": "io.github.gdhub-io/character-forge-mcp",
  "description": "MCP server, CLI and Claude Code plugin for characters with a story that holds together: a full character card from one causal chain, a look derived from the story, an A-pose concept sheet, and on request a scene, a looping video, a voice and a theme. For film, games, ads and books.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test": "npm run build && node --test test/*.test.mjs",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js",
    "lint": "biome check --diagnostic-level=error .",
    "format": "biome check --write .",
    "prepack": "npm run build"
  },
  "keywords": [
    "ai",
    "character",
    "character-creator",
    "character-design",
    "claude",
    "claude-code",
    "concept-art",
    "gamedev",
    "mcp",
    "model-context-protocol",
    "screenwriting",
    "storytelling",
    "worldbuilding"
  ],
  "author": "Dzmitry Drynau",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gdhub-io/character-forge-mcp.git"
  },
  "homepage": "https://github.com/gdhub-io/character-forge-mcp#readme",
  "bugs": {
    "url": "https://github.com/gdhub-io/character-forge-mcp/issues"
  },
  "type": "module",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  },
  "bin": {
    "character-forge": "dist/index.js"
  },
  "files": [
    "dist",
    "models.json",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
